# omp-server/.env.example — copy to .env (chmod 600) and fill in.
# ./install.sh mints ELIA_AUTH_TOKEN for you if .env does not already have one.

# Bearer token for every /status, /trigger, /sessions, /tunnel/* call.
# Empty = auth DISABLED (only safe on loopback). Generate with: openssl rand -hex 32
ELIA_AUTH_TOKEN=

# Bind address inside the container. Keep 0.0.0.0 for docker; the published port
# stays bound to loopback on the host.
HOST=0.0.0.0

# Max simultaneous agent runs. Over the cap the server answers HTTP 202 with
# {"status":"queued_429"} instead of running. Hard cap 100.
MAX_CONCURRENT_RUNS=8

# No frames for STALL_TIMEOUT_S seconds -> mark failed + error banner + notify.
STALL_TIMEOUT_S=300

# Absolute ceiling on a single run, regardless of activity. -> failed + banner.
MAX_RUN_S=3600

# Discord webhook for failure/completion banners. 300s debounce, never logged.
DISCORD_WEBHOOK_URL=

# Optional: point the persona/model lookup somewhere other than ~/.omp/agent.
# OMP_AGENT_DIR=/root/.omp/agent

# proxy-local extension debug log (in-process residential forward).
PROXY_LOCAL_OMP_DEBUG=0