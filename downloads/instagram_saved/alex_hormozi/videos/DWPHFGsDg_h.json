ens": [50479, 264, 2636, 1064, 294, 264, 1606, 13, 50533], "temperature": 0.0, "avg_logprob": -0.1296595460879877, "compression_ratio": 1.7595307917888563, "no_speech_prob": 0.004864157643169165}, {"id": 54, "seek": 8662, "start": 90.0, "end": 91.36, "text": " And the fourth year, we started Allen,", "tokens": [50533, 400, 264, 6409, 1064, 11, 321, 1409, 17160, 11, 50601], "temperature": 0.0, "avg_logprob": -0.1296595460879877, "compression_ratio": 1.7595307917888563, "no_speech_prob": 0.004864157643169165}, {"id": 55, "seek": 8662, "start": 91.36, "end": 92.76, "text": " which is a lead working software.", "tokens": [50601, 597, 307, 257, 1477, 1364, 4722, 13, 50671], "temperature": 0.0, "avg_logprob": -0.1296595460879877, "compression_ratio": 1.7595307917888563, "no_speech_prob": 0.004864157643169165}, {"id": 56, "seek": 8662, "start": 92.76, "end": 96.28, "text": " We sold all three of those companies in 2021, $46.2 million.", "tokens": [50671, 492, 3718, 439, 1045, 295, 729, 3431, 294, 7201, 11, 1848, 16169, 13, 17, 2459, 13, 50847], "temperature": 0.0, "avg_logprob": -0.1296595460879877, "compression_ratio": 1.7595307917888563, "no_speech_prob": 0.004864157643169165}, {"id": 57, "seek": 8662, "start": 96.28, "end": 98.04, "text": " From there, we started acquisition.com", "tokens": [50847, 3358, 456, 11, 321, 1409, 21668, 13, 1112, 50935], "temperature": 0.0, "avg_logprob": -0.1296595460879877, "compression_ratio": 1.7595307917888563, "no_speech_prob": 0.004864157643169165}, {"id": 58, "seek": 8662, "start": 98.04, "end": 99.76, "text": " with the 40 plus million in distributions", "tokens": [50935, 365, 264, 3356, 1804, 2459, 294, 37870, 51021], "temperature": 0.0, "avg_logprob": -0.1296595460879877, "compression_ratio": 1.7595307917888563, "no_speech_prob": 0.004864157643169165}, {"id": 59, "seek": 8662, "start": 99.76, "end": 100.92, "text": " and the $46 million sale.", "tokens": [51021, 293, 264, 1848, 16169, 2459, 8680, 13, 51079], "temperature": 0.0, "avg_logprob": -0.1296595460879877, "compression_ratio": 1.7595307917888563, "no_speech_prob": 0.004864157643169165}, {"id": 60, "seek": 8662, "start": 100.92, "end": 102.60000000000001, "text": " We took the cash and started investing in companies.", "tokens": [51079, 492, 1890, 264, 6388, 293, 1409, 10978, 294, 3431, 13, 51163], "temperature": 0.0, "avg_logprob": -0.1296595460879877, "compression_ratio": 1.7595307917888563, "no_speech_prob": 0.004864157643169165}, {"id": 61, "seek": 8662, "start": 102.60000000000001, "end": 104.12, "text": " And today, five years later,", "tokens": [51163, 400, 965, 11, 1732, 924, 1780, 11, 51239], "temperature": 0.0, "avg_logprob": -0.1296595460879877, "compression_ratio": 1.7595307917888563, "no_speech_prob": 0.004864157643169165}, {"id": 62, "seek": 8662, "start": 104.12, "end": 106.2, "text": " our aggregate portfolio is $250 million a year.", "tokens": [51239, 527, 26118, 12583, 307, 1848, 23538, 2459, 257, 1064, 13, 51343], "temperature": 0.0, "avg_logprob": -0.1296595460879877, "compression_ratio": 1.7595307917888563, "no_speech_prob": 0.004864157643169165}, {"id": 63, "seek": 8662, "start": 106.2, "end": 107.26, "text": " The business that you're in right now", "tokens": [51343, 440, 1606, 300, 291, 434, 294, 558, 586, 51396], "temperature": 0.0, "avg_logprob": -0.1296595460879877, "compression_ratio": 1.7595307917888563, "no_speech_prob": 0.004864157643169165}, {"id": 64, "seek": 8662, "start": 107.26, "end": 108.60000000000001, "text": " is probably not the one you're gonna end up in,", "tokens": [51396, 307, 1391, 406, 264, 472, 291, 434, 799, 917, 493, 294, 11, 51463], "temperature": 0.0, "avg_logprob": -0.1296595460879877, "compression_ratio": 1.7595307917888563, "no_speech_prob": 0.004864157643169165}, {"id": 65, "seek": 8662, "start": 108.60000000000001, "end": 111.4, "text": " but the lessons you learn are the ones that you'll keep.", "tokens": [51463, 457, 264, 8820, 291, 1466, 366, 264, 2306, 300, 291, 603, 1066, 13