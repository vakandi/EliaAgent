.52000000000001, "end": 111.6, "text": " over those 72 hours and sold 3.6 million copies", "tokens": [51462, 670, 729, 18731, 2496, 293, 3718, 805, 13, 21, 2459, 14341, 51616], "temperature": 0.0, "avg_logprob": -0.1129320780436198, "compression_ratio": 1.6293333333333333, "no_speech_prob": 0.010899764485657215}, {"id": 60, "seek": 8656, "start": 111.6, "end": 113.6, "text": " that generated $106 million in sales.", "tokens": [51616, 300, 10833, 1848, 3279, 21, 2459, 294, 5763, 13, 51716], "temperature": 0.0, "avg_logprob": -0.1129320780436198, "compression_ratio": 1.6293333333333333, "no_speech_prob": 0.010899764485657215}, {"id": 61, "seek": 8656, "start": 113.6, "end": 114.56, "text": " If you like this kind of stuff,", "tokens": [51716, 759, 291, 411, 341, 733, 295, 1507, 11, 51764], "temperature": 0.0, "avg_logprob": -0.1129320780436198, "compression_ratio": 1.6293333333333333, "no_speech_prob": 0.010899764485657215}, {"id": 62, "seek": 8656, "start": 114.56, "end": 116.28, "text": " follow to see whatever crazy thing we do next,", "tokens": [51764, 1524, 281, 536, 2035, 3219, 551, 321, 360, 958, 11, 51850], "temperature": 0.0, "avg_logprob": -0.1129320780436198, "compression_ratio": 1.6293333333333333, "no_speech_prob": 0.010899764485657215}, {"id": 63, "seek": 11628, "start": 116.28, "end": 117.88, "text": " because it will be even crazier.", "tokens": [50364, 570, 309, 486, 312, 754, 2094, 33352, 13, 50444], "temperature": 0.0, "avg_logprob": -0.348829832944003, "compression_ratio": 0.8, "no_speech_prob": 0.0011757747270166874}], "language": "en"}