# Shim environment — copy to .env and fill secrets. NEVER commit the
# filled .env. NEVER print secret values in logs.
# Ground rule: PORT is 5676 here. NEVER the live ports anywhere in this folder.

# Shim HTTP port (must match docker-compose.yml mapping)
PORT=5676

# Qwen daemon base URL (compose service name; host debug: http://127.0.0.1:4170)
QWEN_URL=http://qwen:4170

# Bearer token the shim daemon shares with qwen (mirrors qwen/.env).
# Generate: openssl rand -hex 32
QWEN_SERVER_TOKEN=CHANGE_ME_qwen_server_token

# Elia-side API auth: empty disables auth (dev); set to require
# Authorization: Bearer <token> or X-Elia-Token on every route but /health.
ELIA_AUTH_TOKEN=CHANGE_ME_elia_auth_token

# Discord webhook for run completed/failed alerts (gap 6 carry-over).
DISCORD_WEBHOOK_URL=CHANGE_ME_discord_webhook_url

# Comma-separated zen-free model fallback chain (gap 9). Defaults live in
# app/qwen_client.py ZEN_FREE_MODELS; set this to override.
# ZEN_FREE_MODELS=muse-spark-1.3-contributor-free,muse-spark-1.2-contributor-free,big-pickle

# Scheduler / runtime
MAX_CONCURRENT_RUNS=8
LOG_LEVEL=INFO
TZ=Africa/Casablanca

# Tunnel sidecar: token is written by POST /tunnel/setup into
# CONFIG_DIR/tunnel.token (gitignored) and picked up by the cloudflared
# watcher. Never put real tokens in this file.
# TUNNEL_TOKEN=
